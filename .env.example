# ---------------------------------------------------------------------------
# Last-Mile Delivery Tracker — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# committed on purpose (deliverable) and holds only dummy placeholders.
# ---------------------------------------------------------------------------

# --- Database (Neon / local Postgres) --------------------------------------
# Pooled connection string used by the running app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. On Neon use the
# "-direct" host; with local Postgres this equals DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- API runtime -----------------------------------------------------------
API_PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the web app).
CORS_ORIGIN="http://localhost:3000"

# --- Auth ------------------------------------------------------------------
# Use long random strings in production. Access + refresh are signed separately.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Set true only when serving over HTTPS (production). Controls the Secure cookie flag.
COOKIE_SECURE=false

# --- Notifications ---------------------------------------------------------
# Leave BOTH blocks blank to use the built-in ConsoleProvider, which logs
# messages and marks them SENT. The full demo works with zero keys.
# Email (Resend REST API):
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="Last-Mile Delivery <delivery@example.com>"
# SMS (Twilio REST API, Basic auth):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Web (Next.js) ---------------------------------------------------------
# Base URL of the API as seen from the browser.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
